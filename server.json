{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.github.askmojood/zammad-mcp",
  "title": "Zammad (Mojood Connect)",
  "description": "Zammad tickets in Claude: find, summarise, add notes and assign after a yes.",
  "repository": {
    "url": "https://github.com/askmojood/zammad-mcp",
    "source": "github"
  },
  "websiteUrl": "https://mojood.app/connect",
  "version": "0.1.0",
  "packages": [
    {
      "registryType": "pypi",
      "identifier": "mojood-zammad-mcp",
      "version": "0.1.0",
      "runtimeHint": "uvx",
      "transport": {
        "type": "stdio"
      },
      "packageArguments": [
        {
          "type": "positional",
          "value": "--stdio",
          "valueHint": "--stdio"
        }
      ],
      "environmentVariables": [
        {
          "name": "ZAMMAD_URL",
          "description": "Your Zammad address",
          "isSecret": false,
          "isRequired": true
        },
        {
          "name": "ZAMMAD_TOKEN",
          "description": "A Zammad API token",
          "isSecret": true,
          "isRequired": true
        },
        {
          "name": "ZAMMAD_SAMPLE",
          "description": "0 for real data (1 labels answers SAMPLE)",
          "isSecret": false,
          "isRequired": false
        }
      ]
    }
  ]
}
